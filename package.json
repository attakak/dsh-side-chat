{
  "name": "dsh-side-chat",
  "version": "0.1.0",
  "description": "侧边聊天：在主对话旁并排开一个临时会话，不污染主线。Side chat beside the main conversation.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "side-chat",
    "侧边聊天"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
